# LEXIA environment template
# Copy this file to .env for local development.
# Never commit real passwords, API keys, or production database URLs.

# Server
PORT=3000
PUBLIC_URL=http://localhost:3000

# PostgreSQL / Supabase
# Local or hosted PostgreSQL connection string.
# In Render, configure this value in Dashboard > Environment, not in this file.
SUPABASE_DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@<HOST>:5432/postgres
# Alternative if you are not using Supabase:
# DATABASE_URL=postgresql://user:<DB_PASSWORD>@host:5432/database
PGSSLMODE=require

# Optional JSON fallback paths
# DATA_DIR=./data
# ACCOUNTS_PATH=./data/accounts.json

# OpenAI provider (optional)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.35

# Grok / xAI provider (optional)
# Official xAI-compatible base URL: https://api.x.ai/v1
XAI_API_KEY=
XAI_MODEL=grok-4.3
GROK_TEMPERATURE=0.35
# Use AI_PROVIDER=grok to make LEXIA answer with Grok using Lexia Engine/RAG context.

# GroqCloud provider (optional, keys usually start with gsk_)
# Official OpenAI-compatible base URL: https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Use AI_PROVIDER=groq to make LEXIA answer with GroqCloud using Lexia Engine/RAG context.

# Ollama provider (optional)
# For local development only:
# OLLAMA_BASE_URL=http://localhost:11434
# For production, use a public HTTPS endpoint reachable from Render.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_ENABLED=true
OLLAMA_PREFER=false
# Use local when no external model provider is configured.
AI_PROVIDER=local
AI_PROVIDER_TIMEOUT_MS=45000
OLLAMA_KEEP_ALIVE=5m
# OLLAMA_API_KEY=

# Frontend override (optional)
# BACKEND_URL=http://localhost:3000

# Legal Intelligence Engine / Brain Lab
# Comma-separated emails allowed to approve or reject verified legal sources.
# Users can propose sources; only curators can approve them for Nueva Consulta.
# Example: LEGAL_CURATOR_EMAILS=legal@example.com,quality@example.com
LEGAL_CURATOR_EMAILS=
# Optional override for trusted legal web domains.
LEGAL_ALLOWED_SOURCE_HOSTS=elperuano.pe,www.elperuano.pe,tc.gob.pe,www.tc.gob.pe,pj.gob.pe,www.pj.gob.pe,gob.pe,www.gob.pe,sunarp.gob.pe,www.sunarp.gob.pe,sunafil.gob.pe,www.sunafil.gob.pe,lpderecho.pe,www.lpderecho.pe
LEGAL_DISCOVERY_SEED_URLS=
LEGAL_WEB_FETCH_TIMEOUT_MS=12000
LEGAL_WEB_MAX_BYTES=6291456
LEGAL_INGEST_MAX_FILE_MB=10
