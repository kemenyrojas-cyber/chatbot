# OpenAI API Configuration
OPENAI_API_KEY=sk-your-actual-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.1

# Server Configuration
PORT=3000

# Database Configuration
# Supabase: Project Settings > Database > Connection string > URI
# Use the Transaction pooler URI for hosted deployments if IPv4 direct connection is unavailable.
SUPABASE_DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres
PGSSLMODE=require

# Optional: Backend URL for frontend
BACKEND_URL=http://localhost:3000
