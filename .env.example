# LEXIA environment template
# Copy this file to .env for local development.
# Never commit real passwords, API keys, or production database URLs.

# Server
PORT=3000
PUBLIC_URL=http://localhost:3000

# PostgreSQL / Supabase
# Local or hosted PostgreSQL connection string.
# In Render, configure this value in Dashboard > Environment, not in this file.
SUPABASE_DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@<HOST>:5432/postgres
# Alternative if you are not using Supabase:
# DATABASE_URL=postgresql://user:<DB_PASSWORD>@host:5432/database
PGSSLMODE=require

# Optional JSON fallback paths
# DATA_DIR=./data
# ACCOUNTS_PATH=./data/accounts.json

# OpenAI provider (optional)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.35

# Grok / xAI provider (optional)
# Official xAI-compatible base URL: https://api.x.ai/v1
XAI_API_KEY=
XAI_MODEL=grok-4.3
GROK_TEMPERATURE=0.35
# Use AI_PROVIDER=grok to make LEXIA answer with Grok using Lexia Engine/RAG context.

# GroqCloud provider (optional, keys usually start with gsk_)
# Official OpenAI-compatible base URL: https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Use AI_PROVIDER=groq to make LEXIA answer with GroqCloud using Lexia Engine/RAG context.

# Cerebras Cloud provider (optional)
# Official OpenAI-compatible base URL: https://api.cerebras.ai/v1
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_TEMPERATURE=0.25
CEREBRAS_MAX_TOKENS=2000
# Use AI_PROVIDER=cerebras to prefer Cerebras as the synthesis provider.

# Ollama provider (optional)
# Local development, when Ollama is running on this same machine:
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Render production cannot use your PC localhost. Use a public HTTPS Ollama
# endpoint or a private service URL reachable from the Render backend.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_ENABLED=true
OLLAMA_PREFER=false
# Use AI_PROVIDER=auto for LEXIA orchestration: RAG/local first, external models as support.
# Use AI_PROVIDER=local only to disable external model calls.
AI_PROVIDER=auto
LEXIA_PROVIDER_STRATEGY=fallback
# For real consultation + synthesis with both services:
# LEXIA_PROVIDER_STRATEGY=ensemble
# LEXIA_CONSULTANTS=groq,cerebras
AI_PROVIDER_TIMEOUT_MS=45000
LEXIA_PYTHON_BRAIN_ENABLED=true
LEXIA_PYTHON_BRAIN_TIMEOUT_MS=2500
# En Windows suele ser "python"; en Linux y Docker, "python3".
LEXIA_PYTHON_EXECUTABLE=python
OLLAMA_KEEP_ALIVE=5m
# Only needed if your Ollama endpoint is protected by a bearer token.
# OLLAMA_API_KEY=

# Flow control / rate limiting for massive public usage
LEXIA_RATE_LIMIT_ENABLED=true
LEXIA_RATE_LIMIT_WINDOW_MS=60000
LEXIA_RATE_LIMIT_MAX=30
LEXIA_RATE_LIMIT_BUCKET_LIMIT=10000

# Frontend override (optional)
# BACKEND_URL=http://localhost:3000

# Legal Intelligence Engine / Brain Lab
# Comma-separated emails allowed to approve or reject verified legal sources.
# Users can propose sources; only curators can approve them for Nueva Consulta.
# Example: LEGAL_CURATOR_EMAILS=legal@example.com,quality@example.com
LEGAL_CURATOR_EMAILS=admin@example.com
# Optional override for trusted legal web domains.
LEGAL_ALLOWED_SOURCE_HOSTS=elperuano.pe,www.elperuano.pe,tc.gob.pe,www.tc.gob.pe,pj.gob.pe,www.pj.gob.pe,gob.pe,www.gob.pe,sunarp.gob.pe,www.sunarp.gob.pe,sunafil.gob.pe,www.sunafil.gob.pe,lpderecho.pe,www.lpderecho.pe,estudioderechoylibertad.com,www.estudioderechoylibertad.com
LEGAL_DISCOVERY_SEED_URLS=https://elperuano.pe/derecho,https://www.tc.gob.pe/jurisprudencia/,https://www.gob.pe/busquedas?term=leyes,https://www.sunafil.gob.pe/noticias/,https://lpderecho.pe/laboral/
LEGAL_WEB_FETCH_TIMEOUT_MS=12000
LEGAL_WEB_MAX_BYTES=6291456
LEGAL_INGEST_MAX_FILE_MB=10

# Optional web search discovery for feeding Lexia from public legal pages.
# Browsers such as Chrome/Firefox do not provide content APIs; use search APIs to discover URLs.
# Keep LEGAL_ALLOWED_SOURCE_HOSTS restricted to trusted legal domains.
LEGAL_WEB_SEARCH_ENABLED=true
LEGAL_WEB_SEARCH_PROVIDERS=brave,bing,google,serpapi
BRAVE_SEARCH_API_KEY=
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
SERPAPI_API_KEY=
